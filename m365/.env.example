# SERVER-ONLY configuration; never commit actual values.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Audience on Entra access token for the backend (e.g. api://<backend-app-client-id>)
AZURE_API_AUDIENCE=
# The exact approved organizational SharePoint site (NOT a personal OneDrive site)
SHAREPOINT_SITE_ID=
SHAREPOINT_HOSTNAME=your-adra-tenant.sharepoint.com
# Output from npm run setup after ADRA tenant consent/provisioning
M365_LISTS_JSON=
M365_DOCUMENT_DRIVE_ID=
# Exact HTTPS UI origin (wildcards prohibited)
ALLOWED_ORIGIN=https://procurement.example.org
# Disabled until multi-writer ledger/reconciliation is approved
M365_MANUAL_PAYMENT_WRITES=disabled
PORT=3000
