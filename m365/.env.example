# Copy to m365/.env on the SERVER only. Never commit real values.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Entra access-token audience of this API (typically api://<client-id>).
AZURE_API_AUDIENCE=
SHAREPOINT_SITE_ID=
# Populated by npm run setup after organizational consent and provisioning
# M365_LISTS_JSON={"requests":"...","payments":"...", ...}
M365_LISTS_JSON=
M365_DOCUMENT_DRIVE_ID=
# Allowed browser origin (no wildcard)
ALLOWED_ORIGIN=https://procurement.example.org
PORT=3000
